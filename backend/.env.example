# — Apex Vouchers Environment (example) —
# Copy this file to .env and fill in real values. Never commit .env.

# Database
MONGODB_URI=

# JWT Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Client & Server URLs
CLIENT_URL=http://localhost:5173
# Public base URL of THIS API (used to build the Razorpay webhook URL you paste
# into the Razorpay dashboard: <SERVER_URL>/api/payments/webhook).
SERVER_URL=http://localhost:5000
PORT=5000
# development | production.  MUST be "production" on the live server: it enables
# the payment-config guard (live key + webhook secret required), hides internal
# error details, and turns off stack traces in API responses.
NODE_ENV=development
# Comma-separated extra browser origins allowed by CORS (prod frontend domains).
CORS_EXTRA_ORIGINS=

# Centralized Business & Support Details
BUSINESS_NAME=
BUSINESS_EMAIL=
SUPPORT_EMAIL=
SUPPORT_PHONE=
ADMIN_NOTIFICATION_EMAIL=

# Initial Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ==========================================
# Payment Provider — Razorpay
# ==========================================
PAYMENT_PROVIDER=razorpay
# Key ID is PUBLISHABLE — it is sent to the browser for Razorpay Checkout.
#   Development: rzp_test_xxxxxxxxxxxxxx   (Dashboard → test mode → API Keys)
#   Production : rzp_live_xxxxxxxxxxxxxx   (Dashboard → live mode → API Keys)
# The rzp_test_/rzp_live_ prefix is the ONLY thing that switches test vs live —
# there is no separate URL or RAZORPAY_ENV toggle. With NODE_ENV=production the
# server refuses to start unless this is an rzp_live_ key.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Key Secret is SERVER-ONLY. Never expose it to the frontend, logs, or git.
# Rotate it immediately if it is ever pasted anywhere outside this file.
RAZORPAY_KEY_SECRET=
# Webhook signing secret — the exact value you set in the Razorpay Dashboard →
# Settings → Webhooks (a DIFFERENT string from the API key secret). Subscribe to:
# payment.captured, payment.failed, order.paid.
# Webhook URL: <SERVER_URL>/api/payments/webhook
# REQUIRED in production (the server refuses to start without it).
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# Multi-currency: geo detection + live USD/INR FX
# ==========================================
# INR is the canonical base price. Visitors detected OUTSIDE India see (and
# pay in) USD derived from the live USD/INR rate — see backend/services/geo.js
# and backend/services/fx.js.
#
# FX provider returning a JSON body with a USD→INR rate. Default is the free
# endpoint below (no key required) — do NOT set FX_API_KEY unless your provider
# actually needs one (sent as "Authorization: Bearer <key>").
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_API_KEY=
# How long a fetched rate is served from cache (seconds). 900 = 15 minutes.
FX_RATE_CACHE_TTL=900
# When the provider is unreachable, a stale cached rate may still be used up
# to this age (seconds). 21600 = 6 hours. Beyond it, USD checkout is refused
# (INR checkout keeps working).
FX_RATE_MAX_AGE_SECONDS=21600
# OPTIONAL explicit international pricing buffer, percent 0–X. Default 0 —
# never add a hidden markup. Applied only to USD conversions.
INTERNATIONAL_FX_MARKUP_PERCENT=0
# Optional IP→country geolocation service with "{ip}" placeholder, e.g.
# https://ipapi.co/{ip}/country/ . Country detection prefers platform geo
# headers (cf-ipcountry / x-vercel-ip-country etc.), then this service, then
# GEO_IP_API_URL_FALLBACK, then GEO_FALLBACK_COUNTRY below. Set it EMPTY to
# disable outbound IP lookups entirely (headers + fallback country only). A
# VPN's exit-node IP is geolocated the same as any other public IP — no
# special handling needed, it's just "whatever country that IP is in".
GEO_IP_API_URL=https://ipapi.co/{ip}/country/
# SECOND, independent geolocation provider (different host) tried only when
# GEO_IP_API_URL above times out, errors, or is inconclusive — so one free
# provider's outage/rate-limit can't silently misclassify international/VPN
# visitors as India. Set it EMPTY to disable (primary + fallback country only).
GEO_IP_API_URL_FALLBACK=https://get.geojs.io/v1/ip/country/{ip}.json
# Country used when detection is inconclusive (default: home market → INR).
GEO_FALLBACK_COUNTRY=IN

# SMTP Email (transactional) — powers the registration OTP AND the voucher email.
# All four of HOST / USER / PASSWORD / FROM are required or email is disabled and
# the server logs "[email] provider configured: NO".
#
#   Gmail (dev / low volume): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#     SMTP_USER=<full gmail address>, SMTP_PASSWORD=<16-char App Password>
#     (2-Step Verification must be ON), SMTP_FROM must use the SAME address as
#     SMTP_USER (Gmail rewrites/rejects a mismatched From).
#   Production: use a transactional provider (Resend / SendGrid / Amazon SES /
#     Mailgun) with your own verified sending domain + SPF, DKIM and DMARC.
#     Personal-Gmail relay to strict receivers (universities, corporates) is
#     frequently spam-filtered or silently bounced.
#
# Diagnose:  npm run check:email            (config + connection/auth)
#            npm run check:email you@x.com  (real test send)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@apexvouchers.com
SMTP_PASSWORD=
SMTP_FROM="Apex Vouchers" <info@apexvouchers.com>
SMTP_SECURE=true

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ==========================================
# SEO
# ==========================================
# Canonical/absolute site URL used for sitemap URLs, canonical tags and
# structured data. No external API keys or OAuth are required for SEO.
SEO_SITE_URL=https://apexvouchers.com
